{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.6", "generated_at": "2026-11-09T20:15:26.661706Z", "invocation_id": "07a1460c-c20a-410f-acdd-148cbcce49f5", "invocation_started_at": "2026-11-09T20:15:25.977498Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.475767Z", "completed_at": "2026-11-09T20:15:26.479478Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.479616Z", "completed_at": "2026-11-09T20:15:26.479622Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.004189968109130859, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.fraud_dbt.stg_transactions", "compiled": true, "compiled_code": "\n\nselect\n    transaction_time,\n    toDate(transaction_time) as transaction_date,\n    toHour(transaction_time) as transaction_hour,\n    toDayOfWeek(transaction_time) as day_of_week,\n    trim(merch) as merchant_name,\n    trim(cat_id) as category,\n    amount,\n    \n    case\n        when amount < 50 then 'small'\n        when amount < 200 then 'medium'\n        when amount < 1000 then 'large'\n        else 'very_large'\n    end\n as amount_segment,\n    toUInt8(amount >= 500) as is_large_transaction,\n    concat(trim(name_1), ' ', trim(name_2)) as customer_id,\n    upper(gender) as gender,\n    us_state,\n    lat,\n    lon,\n    merchant_lat,\n    merchant_lon,\n    round(greatCircleDistance(lon, lat, merchant_lon, merchant_lat) / 1000, 2) as distance_km,\n    target as is_fraud\nfrom `fraud`.`transactions`", "relation_name": "`fraud`.`stg_transactions`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.480466Z", "completed_at": "2026-11-09T20:15:26.480818Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.480999Z", "completed_at": "2026-11-09T20:15:26.481003Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0010209083557128906, "adapter_response": {}, "message": null, "failures": null, "unique_id": "seed.fraud_dbt.states", "compiled": null, "compiled_code": null, "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.481727Z", "completed_at": "2026-11-09T20:15:26.482745Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.482870Z", "completed_at": "2026-11-09T20:15:26.482873Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0014913082122802734, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.fraud_dbt.mart_customer_risk_profile", "compiled": true, "compiled_code": "\n\nwith customers as (\n    select\n        customer_id,\n        count() as transactions_count,\n        sum(amount) as total_amount,\n        avg(amount) as avg_amount,\n        sum(is_fraud) as fraud_transactions,\n        uniqExact(merchant_name) as unique_merchants,\n        min(transaction_time) as first_transaction_at,\n        max(transaction_time) as last_transaction_at\n    from `fraud`.`stg_transactions`\n    group by customer_id\n),\n\nrated as (\n    select\n        *,\n        round(100 * fraud_transactions / transactions_count, 4) as fraud_rate\n    from customers\n)\n\nselect\n    *,\n    case\n        when fraud_rate >= 5 then 'HIGH'\n        when fraud_transactions > 0 then 'MEDIUM'\n        else 'LOW'\n    end as risk_segment\nfrom rated", "relation_name": "`fraud`.`mart_customer_risk_profile`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.483523Z", "completed_at": "2026-11-09T20:15:26.484443Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.484566Z", "completed_at": "2026-11-09T20:15:26.484569Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.001337289810180664, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.fraud_dbt.mart_daily_state_metrics", "compiled": true, "compiled_code": "\n\nselect\n    transaction_date,\n    us_state,\n    count() as transactions_count,\n    sum(amount) as total_amount,\n    avg(amount) as avg_amount,\n    quantile(0.95)(amount) as p95_amount,\n    avg(is_large_transaction) as large_transactions_share\nfrom `fraud`.`stg_transactions`\ngroup by transaction_date, us_state", "relation_name": "`fraud`.`mart_daily_state_metrics`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.485210Z", "completed_at": "2026-11-09T20:15:26.485982Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.486101Z", "completed_at": "2026-11-09T20:15:26.486104Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.001207113265991211, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.fraud_dbt.mart_fraud_by_category", "compiled": true, "compiled_code": "\n\nwith agg as (\n    select\n        category,\n        count() as total_transactions,\n        sum(is_fraud) as fraud_transactions,\n        sum(amount) as total_amount,\n        sumIf(amount, is_fraud = 1) as fraud_amount\n    from `fraud`.`stg_transactions`\n    group by category\n)\n\nselect\n    category,\n    total_transactions,\n    fraud_transactions,\n    round(100 * fraud_transactions / total_transactions, 4) as fraud_rate,\n    total_amount,\n    fraud_amount\nfrom agg", "relation_name": "`fraud`.`mart_fraud_by_category`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.486725Z", "completed_at": "2026-11-09T20:15:26.487573Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.487695Z", "completed_at": "2026-11-09T20:15:26.487697Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0013530254364013672, "adapter_response": {}, "message": null, "failures": null, 