ate\n    from agg\n)\n\nselect\n    *,\n    toUInt8(total_transactions >= 20 and fraud_rate >= 2) as is_suspicious\nfrom rated", "relation_name": "`fraud`.`mart_merchant_analytics`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.490000Z", "completed_at": "2026-11-09T20:15:26.502562Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.502717Z", "completed_at": "2026-11-09T20:15:26.502722Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.013170242309570312, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.fraud_dbt.accepted_values_stg_transactions_amount_segment__small__medium__large__very_large.467a5d2e4c", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        amount_segment as value_field,\n        count(*) as n_records\n\n    from `fraud`.`stg_transactions`\n    group by amount_segment\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'small','medium','large','very_large'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-09T20:15:26.503429Z", "completed_at": "2026-11-09T20:15:26.506254Z"}, {"name": "execute", "started_at": "2026-11-09T20:15:26.506383Z", "completed_at": "2026-11-09T20:15:26.506386Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.003276824951171875, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.fraud_dbt.accepted_values_stg_transactions_day_of_week__False__1__2__3__4__5__6__7.89ed00f1dc", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        day_of_week as value_field,\n        count(*) as n_records\n\n    from `fraud`.`stg_transactions`\n    group by day_of_week\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    1,2,3,4,5,6,7\n)\n\n\n", "relation_name"